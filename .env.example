DATABASE_URL="postgresql://username:password@localhost:5432/hj-ai"
AWS_REGION="us-east-2"
BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-6"
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"
PORT="11000"
DEMO_PORT="11001"
SERVICE_DEMO_PORT="11002"
API_BASE_URL="https://ai.hjshub.com"
SWAGGER_PATH="api-docs"
# Production default is false. Set true only for an explicitly protected environment.
SWAGGER_ENABLED="false"
# Exact browser origins only, comma-separated. Empty means CORS middleware is disabled.
CORS_ALLOWED_ORIGINS="http://127.0.0.1:11001,http://127.0.0.1:11002"
# Compatibility/development routes are closed unless explicitly enabled.
ENABLE_TEST_TABLE_API="false"
ENABLE_LEGACY_BEDROCK_INSPECTION_API="false"
ENABLE_LEGACY_KNOWLEDGE_WRITE_API="false"
# Public and current Compose standard: serve routes from the domain root.
API_GLOBAL_PREFIX=""
APPKEY_JWT_SECRET="replace-with-a-long-random-secret"
APPKEY_TTL_DAYS="90"
APPKEY_MAX_ROTATION_GRACE_SECONDS="86400"
ADMIN_API_KEY="replace-with-a-different-long-random-admin-key"
KNOWLEDGE_OPERATOR_API_KEY="replace-with-a-third-long-random-operator-key"
# During a zero-downtime rotation, temporarily set each previous key and expiry together.
# ADMIN_API_KEY_PREVIOUS="previous-admin-key"
# ADMIN_API_KEY_PREVIOUS_VALID_UNTIL="2026-08-06T00:00:00.000Z"
# KNOWLEDGE_OPERATOR_API_KEY_PREVIOUS="previous-operator-key"
# KNOWLEDGE_OPERATOR_API_KEY_PREVIOUS_VALID_UNTIL="2026-08-06T00:00:00.000Z"
AWS_S3_BUCKET="your-s3-bucket"
AWS_S3_REGION="us-east-2"
AWS_S3_CDN_URL="https://cdn.example.com"
# Knowledge multipart and parser hard limit. Allowed range: 1-100 MB.
KNOWLEDGE_MAX_FILE_SIZE_MB="30"
# Optional comma-separated allowlist. Defaults to txt,md,json,csv,xlsx,xls,pdf,docx.
# KNOWLEDGE_ALLOWED_EXTENSIONS="txt,md,json,csv,xlsx,xls,pdf,docx"

# Local development only. Prefer IAM roles in deployed AWS environments.
# Do not define optional AWS variables as empty strings.
# AWS_PROFILE="your-profile"
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"
# AWS_SESSION_TOKEN="your-session-token"
# Alternative Bedrock API key auth, if used instead of IAM credentials:
# AWS_BEARER_TOKEN_BEDROCK="your-bedrock-api-key"
