{
  "name": "HJ AI Server 핵심 계약 점검",
  "version": "1.3.0",
  "description": "파괴적 변경 없이 상태, 관리자·appkey 인증, correlation ID, Bedrock 및 RAG 기본 계약을 확인합니다.",
  "tests": [
    {
      "id": "CON-001",
      "name": "상태 endpoint가 응답한다",
      "operationId": "health",
      "sendAppkey": false,
      "expect": { "statuses": [200], "correlationId": true }
    },
    {
      "id": "CON-002",
      "name": "필수 dependency가 준비됐다",
      "operationId": "health.ready",
      "sendAppkey": false,
      "expect": { "statuses": [200], "bodyIncludes": "ready", "correlationId": true }
    },
    {
      "id": "CON-003",
      "name": "보호 endpoint는 appkey 없이 거절한다",
      "operationId": "bedrock.general",
      "sendAppkey": false,
      "expect": { "statuses": [401], "correlationId": true }
    },
    {
      "id": "CON-004",
      "name": "잘못된 correlation ID를 거절한다",
      "operationId": "health",
      "sendAppkey": false,
      "correlationId": "not-a-uuid",
      "expect": { "statuses": [400], "bodyIncludes": "VALIDATION_ERROR", "correlationId": true }
    },
    {
      "id": "CON-005",
      "name": "AppInfo는 관리자 credential 없이 거절한다",
      "operationId": "app.list",
      "sendAdminKey": false,
      "expect": { "statuses": [401], "correlationId": true }
    },
    {
      "id": "CON-006",
      "name": "AppInfo는 잘못된 관리자 credential을 거절한다",
      "operationId": "app.list",
      "adminKey": "invalid-admin-credential",
      "expect": { "statuses": [401], "correlationId": true }
    },
    {
      "id": "CON-007",
      "name": "외부 appkey는 AppInfo 관리자 권한을 부여하지 않는다",
      "operationId": "app.list",
      "requiresAppkey": true,
      "sendAppkey": true,
      "sendAdminKey": false,
      "expect": { "statuses": [401], "correlationId": true }
    },
    {
      "id": "CON-008",
      "name": "유효한 관리자 credential로 AppInfo 목록을 조회한다",
      "operationId": "app.list",
      "requiresAdminKey": true,
      "expect": { "statuses": [200], "correlationId": true }
    },
    {
      "id": "CON-009",
      "name": "플랫폼 관리자가 Bedrock 설정을 조회한다",
      "operationId": "bedrock.config",
      "requiresAdminKey": true,
      "expect": { "statuses": [200], "correlationId": true }
    },
    {
      "id": "CON-010",
      "name": "저위험 일반 질문 계약을 확인한다",
      "operationId": "bedrock.general",
      "requiresAppkey": true,
      "body": { "query": "안녕하세요. 오늘도 좋은 하루 보내세요." },
      "expect": { "statuses": [200], "bodyIncludes": "promptVersion", "correlationId": true }
    },
    {
      "id": "CON-011",
      "name": "RAG 검색 계약을 확인한다",
      "operationId": "knowledge.search",
      "requiresAppkey": true,
      "body": { "query": "교환과 환불 정책을 알려주세요.", "limit": 5 },
      "expect": { "statuses": [200], "bodyIncludes": "matches", "correlationId": true }
    },
    {
      "id": "CON-012",
      "name": "제품 답변의 출처·사용량 계약을 확인한다",
      "operationId": "knowledge.answers",
      "requiresAppkey": true,
      "body": { "query": "교환과 환불 정책을 알려주세요.", "strict": true, "includeSources": true, "maxTokens": 512 },
      "expect": { "statuses": [200], "bodyIncludes": "sources", "correlationId": true }
    },
    {
      "id": "CON-013",
      "name": "Legacy Bedrock 설정 조회는 운영에서 숨겨진다",
      "operationId": "bedrock.legacyConfig",
      "requiresAppkey": true,
      "expect": { "statuses": [404], "correlationId": true }
    },
    {
      "id": "CON-014",
      "name": "Legacy 지식 쓰기는 운영에서 숨겨진다",
      "operationId": "knowledge.text",
      "requiresAppkey": true,
      "body": {},
      "expect": { "statuses": [404], "correlationId": true }
    }
  ]
}
