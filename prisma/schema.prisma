generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum KnowledgeAccessLevel {
  PUBLIC
  INTERNAL
  RESTRICTED
}

enum KnowledgeBusinessStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum FamilyKnowledgeAudience {
  FAMILY
  MEMBER
}

enum FamilyKnowledgeSourceType {
  TEXT
  PHOTO_DESCRIPTION
}

enum FamilyKnowledgeSensitivity {
  NON_SENSITIVE
  SENSITIVE
}

enum FamilyKnowledgeDocumentStatus {
  ACTIVE
  DELETED
}

enum FamilyKnowledgeOperation {
  UPSERT
  DELETE
}

enum FamilyKnowledgeEventStatus {
  QUEUED
  PROCESSING
  RETRY
  SUCCEEDED
  FAILED
}

model TestTable {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  @@map("test_table")
}

model AppInfo {
  id                       String                 @id @default(uuid()) @db.Uuid
  appname                  String
  appkey                   String?
  appkeyHash               String?                @unique @map("appkey_hash")
  previousAppkeyHash       String?                @unique @map("previous_appkey_hash")
  appkeyExpiresAt          DateTime?              @map("appkey_expires_at")
  previousAppkeyValidUntil DateTime?              @map("previous_appkey_valid_until")
  appkeyRotatedAt          DateTime?              @map("appkey_rotated_at")
  appcode                  String                 @unique
  allowedAccessLevels      KnowledgeAccessLevel[] @default([]) @map("allowed_access_levels")
  status                   String                 @default("active")
  s3Prefix                 String?                @map("s3_prefix")
  defaultModelId           String?                @map("default_model_id")
  defaultEmbeddingModelId  String?                @map("default_embedding_model_id")
  systemPrompt             String?                @map("system_prompt")
  maxStorageMb             Int?                   @map("max_storage_mb")
  monthlyTokenLimit        Int?                   @map("monthly_token_limit")
  metadata                 Json?
  remark                   String?
  createat                 DateTime               @default(now())
  updateat                 DateTime               @updatedAt

  @@index([status])
  @@map("appinfo")
}

model SecurityAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  eventType      String   @map("event_type")
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id")
  credentialSlot String?  @map("credential_slot")
  appId          String?  @map("app_id") @db.Uuid
  appcode        String?
  requestId      String?  @map("request_id")
  method         String?
  path           String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([appId, createdAt])
  @@index([requestId])
  @@map("security_audit_event")
}

model BedrockSearchLog {
  id           String   @id @default(uuid()) @db.Uuid
  appcode      String
  searchword   String
  searchat     DateTime @default(now())
  responsetime Int
  inputtokens  Int?
  outputtokens Int?
  totaltokens  Int?

  @@index([appcode])
  @@index([searchat])
  @@map("bedrock_search_log")
}

model KnowledgeFile {
  id             String                  @id @default(uuid()) @db.Uuid
  appcode        String
  bucket         String
  key            String
  url            String?
  originalName   String                  @map("original_name")
  mimetype       String
  size           Int
  checksum       String?
  status         String                  @default("uploaded")
  accessLevel    KnowledgeAccessLevel    @default(INTERNAL) @map("access_level")
  businessStatus KnowledgeBusinessStatus @default(DRAFT) @map("business_status")
  productCodes   String[]                @default([]) @map("product_codes")
  effectiveFrom  DateTime?               @map("effective_from")
  effectiveTo    DateTime?               @map("effective_to")
  errorMessage   String?                 @map("error_message")
  metadata       Json?
  indexedAt      DateTime?               @map("indexed_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  chunks    KnowledgeChunk[]
  indexJobs KnowledgeIndexJob[]

  @@unique([appcode, key])
  @@index([appcode])
  @@index([status])
  @@index([appcode, status, accessLevel, businessStatus])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([createdAt])
  @@map("knowledge_file")
}

model KnowledgeIndexJob {
  id             String    @id @default(uuid()) @db.Uuid
  fileId         String    @map("file_id") @db.Uuid
  appcode        String
  operation      String
  status         String    @default("queued")
  attempt        Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  idempotencyKey String?   @map("idempotency_key")
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  retryable      Boolean   @default(false)
  nextAttemptAt  DateTime? @map("next_attempt_at")
  requestedAt    DateTime  @default(now()) @map("requested_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  file KnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([appcode, idempotencyKey])
  @@index([appcode, status, requestedAt])
  @@index([fileId, status])
  @@index([status, leaseExpiresAt])
  @@index([status, nextAttemptAt, requestedAt])
  @@map("knowledge_index_job")
}

model KnowledgeChunk {
  id              String                       @id @default(uuid()) @db.Uuid
  fileId          String                       @map("file_id") @db.Uuid
  appcode         String
  chunkNo         Int                          @map("chunk_no")
  content         String
  contentHash     String?                      @map("content_hash")
  tokenCount      Int?                         @map("token_count")
  page            Int?
  metadata        Json?
  embedding       Float[]                      @default([])
  embeddingVector Unsupported("vector(1024)")? @map("embedding_vector")
  embeddingModel  String?                      @map("embedding_model")
  indexProvenance Json?                        @map("index_provenance")
  createdAt       DateTime                     @default(now()) @map("created_at")

  file KnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, chunkNo])
  @@index([appcode])
  @@index([embeddingModel])
  @@index([fileId])
  @@map("knowledge_chunk")
}

model KnowledgeQueryLog {
  id              String   @id @default(uuid()) @db.Uuid
  appcode         String
  question        String
  response        String?
  matchedChunkIds Json?    @map("matched_chunk_ids")
  modelId         String?  @map("model_id")
  embeddingModel  String?  @map("embedding_model")
  responsetime    Int?
  inputtokens     Int?
  outputtokens    Int?
  totaltokens     Int?
  requestId       String?  @map("request_id")
  execution       Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([appcode])
  @@index([createdAt])
  @@index([requestId])
  @@map("knowledge_query_log")
}

model FamilyKnowledgeDocument {
  id             String                        @id @default(uuid()) @db.Uuid
  appcode        String
  tenantRef      String                        @map("tenant_ref") @db.VarChar(64)
  memberRef      String?                       @map("member_ref") @db.VarChar(64)
  audience       FamilyKnowledgeAudience
  sourceId       String                        @map("source_id") @db.VarChar(191)
  sourceVersion  Int                           @map("source_version")
  sourceType     FamilyKnowledgeSourceType     @map("source_type")
  sensitivity    FamilyKnowledgeSensitivity
  status         FamilyKnowledgeDocumentStatus @default(ACTIVE)
  title          String?                       @db.VarChar(200)
  content        String?
  publishedAt    DateTime                      @map("published_at")
  indexedAt      DateTime?                     @map("indexed_at")
  embeddingModel String?                       @map("embedding_model")
  createdAt      DateTime                      @default(now()) @map("created_at")
  updatedAt      DateTime                      @updatedAt @map("updated_at")
  deletedAt      DateTime?                     @map("deleted_at")

  chunks FamilyKnowledgeChunk[]

  @@unique([appcode, sourceId])
  @@index([appcode, tenantRef, audience, memberRef, status])
  @@index([status, indexedAt])
  @@map("family_knowledge_document")
}

model FamilyKnowledgeChunk {
  id              String                       @id @default(uuid()) @db.Uuid
  documentId      String                       @map("document_id") @db.Uuid
  appcode         String
  tenantRef       String                       @map("tenant_ref") @db.VarChar(64)
  memberRef       String?                      @map("member_ref") @db.VarChar(64)
  audience        FamilyKnowledgeAudience
  sourceVersion   Int                          @map("source_version")
  chunkNo         Int                          @map("chunk_no")
  content         String
  contentHash     String                       @map("content_hash") @db.VarChar(64)
  embedding       Float[]                      @default([])
  embeddingVector Unsupported("vector(1024)")? @map("embedding_vector")
  embeddingModel  String                       @map("embedding_model")
  createdAt       DateTime                     @default(now()) @map("created_at")

  document FamilyKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sourceVersion, chunkNo])
  @@index([appcode, tenantRef, audience, memberRef, embeddingModel])
  @@index([documentId, sourceVersion])
  @@map("family_knowledge_chunk")
}

model FamilyKnowledgeEvent {
  id             String                     @id @default(uuid()) @db.Uuid
  appcode        String
  sourceId       String                     @map("source_id") @db.VarChar(191)
  sourceVersion  Int                        @map("source_version")
  operation      FamilyKnowledgeOperation
  payloadHash    String                     @map("payload_hash") @db.VarChar(64)
  status         FamilyKnowledgeEventStatus @default(QUEUED)
  resultCode     String?                    @map("result_code") @db.VarChar(64)
  attemptCount   Int                        @default(0) @map("attempt_count")
  maxAttempts    Int                        @default(3) @map("max_attempts")
  nextAttemptAt  DateTime?                  @map("next_attempt_at")
  leaseExpiresAt DateTime?                  @map("lease_expires_at")
  errorCode      String?                    @map("error_code") @db.VarChar(128)
  retryable      Boolean                    @default(false)
  completedAt    DateTime?                  @map("completed_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@unique([appcode, sourceId, sourceVersion, operation])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("family_knowledge_event")
}
