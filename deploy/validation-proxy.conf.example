# Include inside the confirmed validation HTTPS server block.
# TLS/server_name and the tester password file must be provisioned on that host.
location / {
    auth_basic "HJ validation testing";
    auth_basic_user_file /etc/nginx/hj-validation.htpasswd;
    proxy_pass http://127.0.0.1:11001;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 600s;
    client_max_body_size 40m;
    add_header Cache-Control "no-store" always;
}
